# ---------------------------------------------------------------
# ---------- 运行：docker build -f Dockerfile.vllm.gpu -t funasr-nano_vllm:gpu_1.1 .
# ---------------------------------------------------------------

# 使用纯净的 Ubuntu 22.04 基础镜像
# (vLLM 安装的预编译 wheel 中已经打包了对应版本的 CUDA 运行时动态链接库，因此直接使用 ubuntu 镜像是可以的，
# 但请确保启动容器时挂载了宿主机的 NVIDIA 驱动: --gpus all)
FROM ubuntu:22.04

# 设置非交互式安装环境变量并指定时区
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 设置环境变量，使用 UTF-8 编码
ENV LANG C.UTF-8
ENV LC_ALL C.UTF-8

# 更新系统并安装必要的软件包，通过 deadsnakes PPA 安装 Python 3.12
RUN apt-get update && \
    apt-get install -y git vim wget unzip iputils-ping cron ffmpeg tzdata software-properties-common curl build-essential && \
    add-apt-repository ppa:deadsnakes/ppa -y && \
    apt-get update && \
    apt-get install -y python3.12 python3.12-venv python3.12-dev && \
    rm -rf /var/lib/apt/lists/*

# 创建 python3.12 的虚拟环境 (Ubuntu 22.04 推荐使用 venv 隔离以避免 PEP 668 报错)
RUN python3.12 -m venv /opt/venv

# 配置环境变量，自动激活该虚拟环境
ENV PATH="/opt/venv/bin:$PATH"

# 配置 pip 源为清华源，并更新 pip 自身
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip install --upgrade pip

# 安装 vLLM (它会自动安装配套的 torch/torchaudio/torchvision 套件，从而锁死这三件套的版本)
RUN pip install "vllm==0.19.1"

# 安装 FunASR 以及其他必须的包
RUN pip install funasr>=1.3.0 && \
    pip install safetensors tiktoken websockets regex fastapi uvicorn python-multipart

# 创建工作目录
RUN mkdir -p /workspace/FunASR
WORKDIR /workspace/FunASR

# 将当前目录复制到容器内的工作目录
COPY . .

# 安装当前项目 (FunASR)
RUN pip install -e .

# 设置环境变量
ENV MODELSCOPE_CACHE=/workspace/models

# 执行命令
CMD ["/bin/bash"]
